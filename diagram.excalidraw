    {
      "id": "BG10jJc42-tscK9tlku2D",
      "type": "text",
      "x": 1880,
      "y": 140,
      "width": 714.9990844726562,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH5",
      "roundness": null,
      "seed": 1322286238,
      "version": 67,
      "versionNonce": 1683134238,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "CambDvn8IiROH4_9JBsip",
          "type": "arrow"
        }
      ],
      "updated": 1777319275442,
      "link": null,
      "locked": false,
      "text": "For each i = 0..7:\n     s1 = (i % 7) + 1\n     s2 = ((i + 2) % 7) + 1\n     s3 = ((i + 4) % 9) + 1\n    C_i = 9E3779B9 * (i + 1)\n    D_i = A5A5A5A5 + i * 01010101\n  mix_i = rotl32(a_i XOR c_i, s1) + rotl32(b_i XOR d_i, s2) + C_i\n   RK_i = substitute_word(mix_i XOR rotl32(d_i, s3))\n next_i = a_i XOR rotl32(RK_i, 7) XOR D_i\n(a,b,c,d) <— (b,c,d,next_i)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For each i = 0..7:\n     s1 = (i % 7) + 1\n     s2 = ((i + 2) % 7) + 1\n     s3 = ((i + 4) % 9) + 1\n    C_i = 9E3779B9 * (i + 1)\n    D_i = A5A5A5A5 + i * 01010101\n  mix_i = rotl32(a_i XOR c_i, s1) + rotl32(b_i XOR d_i, s2) + C_i\n   RK_i = substitute_word(mix_i XOR rotl32(d_i, s3))\n next_i = a_i XOR rotl32(RK_i, 7) XOR D_i\n(a,b,c,d) <— (b,c,d,next_i)",
      "autoResize": true,
      "lineHeight": 1.25
    },
